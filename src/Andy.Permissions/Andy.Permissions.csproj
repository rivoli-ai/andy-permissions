<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Andy.Permissions</PackageId>
    <Title>Andy Permissions</Title>
    <Description>Tool permission / consent system for the Andy stack: Allow/Ask/Deny rule evaluation, layered persistence, and an IToolPermissionGate that Andy.Tools' executor consults before running a tool.</Description>
    <PackageTags>llm;tools;permissions;security;consent</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Andy.Tools" Version="2026.7.21-rc.84" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
